{
    "name": "cvhq-desktop",
    "productName": "CVHQ POS",
    "version": "1.0.0",
    "description": "CVHQ POS - desktop wrapper (Electron) mở app trên server",
    "main": "main.js",
    "author": "CVHQ",
    "license": "UNLICENSED",
    "scripts": {
        "start": "electron .",
        "pack": "electron-packager . \"CVHQ POS\" --platform=win32 --arch=x64 --out=dist --overwrite --prune=true",
        "dist": "electron-builder --win"
    },
    "build": {
        "appId": "com.cvhq.pos",
        "productName": "CVHQ POS",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "build/**"
        ],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "CVHQ POS"
        }
    },
    "devDependencies": {
        "@electron/packager": "^20.2.1",
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8"
    }
}
